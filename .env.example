# Copy to .env (gitignored) and fill in real values:  cp .env.example .env
# The eval runner loads this file at startup; real environment variables take precedence.

# Default backend: Vercel AI Gateway (create a key in the Vercel dashboard -> AI Gateway)
AI_GATEWAY_API_KEY=

# Only needed for --backend openrouter (the paper's original transport)
# OPENROUTER_API_KEY=
